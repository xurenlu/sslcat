# ARM64 CGO 构建 Dockerfile
FROM golang:1.25-alpine AS builder

# 安装 CGO 依赖
RUN apk add --no-cache \
    gcc \
    musl-dev \
    sqlite-dev \
    git

# 设置 Go 代理（中国加速）
ENV GOPROXY=https://goproxy.cn,direct
ENV GO111MODULE=on
ENV CGO_ENABLED=1

WORKDIR /build

# 复制项目文件
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# 构建 ARM64 CGO 版本
RUN go build \
    -ldflags "-s -w -X main.version=v1.3.11-cgo-arm64 -X main.build=$(date -u +%Y-%m-%d_%H:%M:%S)" \
    -o sslcat-linux-arm64-cgo \
    main.go

# 验证构建结果
RUN ls -lh sslcat-linux-arm64-cgo && \
    file sslcat-linux-arm64-cgo && \
    ldd sslcat-linux-arm64-cgo || true

CMD ["sh", "-c", "echo /build/sslcat-linux-arm64-cgo"]

