# 简化的 CGO 构建 Dockerfile
# 直接使用本地已有的镜像
FROM golang:1.25-alpine AS builder

# 安装 CGO 依赖
RUN apk add --no-cache \
    gcc \
    musl-dev \
    sqlite-dev \
    git \
    ca-certificates \
    tzdata

# 设置工作目录
WORKDIR /app

# 设置 Go 代理
ENV GOPROXY=https://goproxy.cn,direct
ENV GO111MODULE=on

# 复制所有文件
COPY . .

# 下载依赖
RUN go mod download

# 构建 CGO 版本（容器内已经是 linux/amd64，不需要指定 GOOS/GOARCH）
RUN CGO_ENABLED=1 go build \
    -ldflags "-s -w -X main.version=v1.3.10 -X main.build=$(date -u +%Y-%m-%d_%H:%M:%S)" \
    -o sslcat-linux-amd64-cgo main.go

# 这个 Dockerfile 只用于构建，不需要运行时镜像

