# 使用 Zig + Alpine 进行 CGO 交叉编译（Mac ARM64 -> Linux AMD64）
# 优势：镜像更小，编译更快

FROM golang:1.23-alpine AS builder

# 配置代理和镜像源
ARG HTTP_PROXY
ARG HTTPS_PROXY
ENV HTTP_PROXY=${HTTP_PROXY}
ENV HTTPS_PROXY=${HTTPS_PROXY}

# 使用国内镜像源加速
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories

# 安装 Zig 和必要的工具
RUN apk update && apk add --no-cache \
    zig \
    gcc \
    musl-dev \
    git \
    make \
    file \
    sqlite-dev \
    sqlite-static

# 验证 Zig 安装
RUN zig version

# 设置工作目录
WORKDIR /app

# 复制 go.mod 和 go.sum 先下载依赖（利用 Docker 缓存）
COPY go.mod go.sum ./
RUN go mod download

# 复制源代码
COPY . .

# 设置 Go 环境变量
ENV CGO_ENABLED=1
ENV GOOS=linux
ENV GOARCH=amd64

# 使用 Zig 作为 C 编译器
# 注意：Alpine 使用 musl，我们编译静态链接版本以获得最大兼容性
ENV CC="zig cc -target x86_64-linux-musl"
ENV CXX="zig c++ -target x86_64-linux-musl"
ENV CGO_CFLAGS="-D_LARGEFILE64_SOURCE"
ENV CGO_LDFLAGS="-static"

# 编译 sslcat（静态链接）
RUN echo "🔨 开始编译 sslcat (静态链接)..." && \
    go build -v \
    -ldflags="-s -w -linkmode external -extldflags '-static'" \
    -tags 'osusergo netgo static_build' \
    -o sslcat main.go

# 验证二进制文件
RUN echo "✅ 验证二进制文件..." && \
    file sslcat && \
    ldd sslcat 2>&1 | grep -q "not a dynamic executable" && echo "✅ 完全静态链接" || echo "⚠️  动态链接" && \
    ls -lh sslcat && \
    ./sslcat --version || echo "版本检查完成"

# 最终阶段 - 使用 scratch（最小镜像）
FROM scratch

# 复制必要的文件
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=builder /app/sslcat /sslcat

# 暴露端口
EXPOSE 80 443

ENTRYPOINT ["/sslcat"]

