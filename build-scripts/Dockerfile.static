# 使用 Debian 基础镜像来构建静态链接的 CGO 二进制文件
FROM golang:1.23-bullseye AS builder

# 安装必要的构建工具和静态库
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    make \
    git \
    file \
    libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

# 设置工作目录
WORKDIR /build

# 复制 go.mod 和 go.sum
COPY go.mod go.sum ./

# 下载依赖
RUN go mod download

# 复制所有源代码
COPY . .

# 设置环境变量
ENV CGO_ENABLED=1
ENV GOOS=linux
ENV GOARCH=amd64

# 构建静态链接的二进制文件
RUN go build \
    -tags 'sqlite_omit_load_extension' \
    -ldflags '-linkmode external -extldflags "-static" -s -w' \
    -o sslcat-static \
    main.go

# 验证二进制文件
RUN file sslcat-static && \
    ldd sslcat-static || echo "静态链接成功（无动态依赖）"

# 最终阶段 - 只包含二进制文件
FROM scratch
COPY --from=builder /build/sslcat-static /sslcat

