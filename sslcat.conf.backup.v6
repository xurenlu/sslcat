{
  "admin": {
    "first_run": false,
    "password_file": "/opt/sslcat/data/admin.pass"
  },
  "cluster": {
    "node_id": "8348dd209d71ce1b"
  },
  "compression": {
    "algorithms": [
      "gzip"
    ],
    "excluded_types": [
      ".jpg",
      ".jpeg",
      ".png",
      ".gif",
      ".webp",
      ".ico",
      ".woff",
      ".woff2",
      ".ttf",
      ".eot",
      ".zip",
      ".gz",
      ".br"
    ],
    "level": {
      "brotli": 4,
      "gzip": 1
    },
    "min_size": 1024,
    "types": [
      ".js",
      ".css",
      ".html",
      ".htm",
      ".xml",
      ".json",
      ".txt",
      ".svg",
      ".md"
    ]
  },
  "image_optimization": {
    "enabled": true
  },
  "proxy": {
    "rules": [
      {
        "auth_cookie_domain": "",
        "auth_enabled": false,
        "auth_session_timeout": 0,
        "backends": [
          {
            "enabled": true,
            "host": "localhost",
            "id": "example.com_backend_1",
            "port": 3000,
            "priority": 0,
            "weight": 1
          }
        ],
        "cdn_enabled": false,
        "cdn_preset": "",
        "cdn_ttl_seconds": 0,
        "cloud_storage_access_key": "",
        "cloud_storage_bucket": "",
        "cloud_storage_endpoint": "",
        "cloud_storage_path": "",
        "cloud_storage_region": "",
        "cloud_storage_secret_key": "",
        "cloud_storage_type": "",
        "connect_timeout_sec": 0,
        "domain": "example.com",
        "enabled": true,
        "expect_continue_timeout_sec": 0,
        "expected_status_code": 0,
        "failover_enabled": false,
        "failure_threshold": 0,
        "git_deploy_app_id": "",
        "git_deploy_app_name": "",
        "health_check_enabled": false,
        "health_check_interval": 0,
        "health_check_method": "",
        "health_check_path": "",
        "health_check_timeout": 0,
        "health_check_timeout_sec": 0,
        "idle_timeout_sec": 0,
        "keep_alive_timeout_sec": 0,
        "managed_by_git_deploy": false,
        "max_retries": 0,
        "optimize_host_header": false,
        "path_exact": false,
        "port": 3000,
        "recovery_threshold": 0,
        "retry_interval": 0,
        "session_affinity_cookie": "",
        "session_affinity_enabled": false,
        "session_affinity_header": "",
        "session_affinity_method": "",
        "session_affinity_ttl": 0,
        "ssl_only": false,
        "target": "localhost",
        "tls_handshake_timeout_sec": 0,
        "websocket_buffer_size": 0,
        "websocket_optimized": false,
        "websocket_ping_interval": 0,
        "websocket_read_timeout": 0,
        "websocket_timeout": 0,
        "websocket_write_timeout": 0
      }
    ]
  },
  "security": {
    "block_duration": "5m0s",
    "ip_blacklist": [],
    "ip_whitelist": [],
    "max_attempts": 3,
    "max_attempts_5min": 10
  },
  "server": {
    "custom_port": 9942,
    "enable_https": false,
    "enable_pprof": true,
    "port": 9942,
    "port_mode": "custom",
    "read_timeout_sec": 30,
    "write_timeout_sec": 30
  },
  "ssl": {
    "auto_renew": false,
    "email": "xurenlu@gmail.com",
    "key_dir": "/opt/sslcat/keys"
  }
}