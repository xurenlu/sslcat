{
  "server": {
    "host": "0.0.0.0",
    "port": 443,
    "debug": false,
    "port_mode": "standard",
    "enable_https": true,
    "access_log_enabled": true,
    "access_log_format": "nginx",
    "access_log_path": "./data/access.log"
  },
  "ssl": {
    "email": "admin@example.com",
    "staging": false,
    "cert_dir": "./data/certs",
    "key_dir": "./data/keys",
    "auto_renew": true,
    "disable_self_signed": false
  },
  "admin": {
    "username": "admin",
    "first_run": true,
    "password_file": "./data/admin.pass",
    "enable_totp": false
  },
  "proxy": {
    "rules": [
      {
        "domain": "example.com",
        "target": "127.0.0.1",
        "port": 8080,
        "enabled": true,
        "ssl_only": false
      }
    ],
    "unmatched_behavior": "502"
  },
  "security": {
    "max_attempts": 900,
    "block_duration": "5s",
    "max_attempts_5min": 3000,
    "block_file": "./data/sslcat.block",
    "enable_ddos": true,
    "enable_captcha": false
  },
  "notification": {
    "enabled": true,
    "channels": {
      "console": {
        "enabled": true
      },
      "email": {
        "enabled": false,
        "smtp_host": "smtp.example.com",
        "smtp_port": 587,
        "username": "notifications@example.com",
        "password": "your_password",
        "from": "SSLcat Notifications <notifications@example.com>",
        "to": ["admin@example.com"],
        "use_tls": true
      },
      "webhook": {
        "enabled": false,
        "url": "https://your-webhook-url.com/notifications",
        "headers": {
          "Content-Type": "application/json",
          "Authorization": "Bearer your_token"
        },
        "timeout": 30
      },
      "syslog": {
        "enabled": false,
        "address": "localhost:514",
        "network": "udp"
      }
    }
  },
  "admin_prefix": "/sslcat-panel",
  "compression": {
    "enabled": true,
    "algorithms": ["br", "gzip"],
    "min_size": 1024,
    "level": {
      "gzip": 6,
      "brotli": 6
    }
  },
  "cdn_cache": {
    "enabled": false,
    "cache_dir": "./data/cache/static",
    "max_size_bytes": 5368709120,
    "default_ttl_seconds": 3600
  }
}

