{
  "server": {
    "host": "0.0.0.0",
    "port_mode": "standard",
    "enable_https": true,
    "access_log_enabled": true
  },
  
  "admin": {
    "username": "admin",
    "password_hash": "$2a$10$..."
  },
  
  "security": {
    "max_attempts": 5,
    "block_duration": "1h"
  },
  
  "ai_security": {
    "enabled": true,
    
    // ===== POE 配置 =====
    // POE 提供了更便宜的 API 访问方式，支持多种模型
    "api_key": "your-poe-api-key-here",
    "api_endpoint": "https://api.poe.com/v1/chat/completions",
    
    // POE 支持的模型选项：
    // - "Assistant" - POE 默认助手
    // - "GPT-4" - GPT-4 模型
    // - "GPT-4-Turbo" - GPT-4 Turbo
    // - "GPT-3.5-Turbo" - GPT-3.5 Turbo
    // - "Claude-3-Opus" - Anthropic Claude 3 Opus
    // - "Claude-3-Sonnet" - Anthropic Claude 3 Sonnet
    // - "Claude-instant" - Claude Instant
    // 等等...查看 https://poe.com/api_key 获取完整列表
    "model": "GPT-4-Turbo",
    
    // 分析配置
    "check_interval": "1h",
    "analysis_window": "1h",
    "max_tokens": 3000,
    "temperature": 0.3,
    "min_events": 10,
    
    // 通知配置
    "notify_on_threat": true,
    "min_threat_level": "medium"
  },
  
  "notification": {
    "enabled": true,
    "channels": {
      "email": {
        "enabled": true,
        "smtp_host": "smtp.example.com",
        "smtp_port": 587,
        "smtp_user": "alerts@example.com",
        "smtp_password": "your-smtp-password",
        "from": "SSLcat Security <alerts@example.com>",
        "to": [
          "admin@example.com",
          "security@example.com"
        ],
        "use_tls": true
      },
      "webhook": {
        "enabled": false,
        "url": "https://hooks.slack.com/services/YOUR/WEBHOOK/URL",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "console": {
        "enabled": true
      }
    }
  }
}

