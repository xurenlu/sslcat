# SSLcat 多邮件发送方式配置示例
# 支持 SMTP、Sendmail、Resend、Mailgun、SendGrid 等多种邮件发送方式

# 基础配置
port = 8080
admin_prefix = "/admin"

# 通知配置
[notification]
enabled = true
channels = ["email", "webhook"]
min_level = "info"

# 邮件通知配置 - 支持多种发送方式
[notification.email]
enabled = true
method = "smtp"  # 可选: smtp, sendmail, resend, mailgun, sendgrid

# SMTP 配置 (当 method = "smtp" 时使用)
smtp_host = "smtp.gmail.com"
smtp_port = 587
username = "your-email@gmail.com"
password = "your-app-password"
from = "noreply@example.com"
to = ["admin@example.com", "support@example.com"]
use_tls = true

# Sendmail 配置 (当 method = "sendmail" 时使用)
# sendmail_command = "/usr/sbin/sendmail"
# sendmail_args = "-t"
# from = "noreply@example.com"
# to = ["admin@example.com", "support@example.com"]

# Resend 配置 (当 method = "resend" 时使用)
# resend_api_key = "re_xxxxxxxxxx"
# resend_from = "noreply@example.com"
# resend_to = "admin@example.com,support@example.com"

# Mailgun 配置 (当 method = "mailgun" 时使用)
# mailgun_api_key = "key-xxxxxxxxxx"
# mailgun_domain = "mg.example.com"
# mailgun_from = "noreply@example.com"
# mailgun_to = "admin@example.com,support@example.com"

# SendGrid 配置 (当 method = "sendgrid" 时使用)
# sendgrid_api_key = "SG.xxxxxxxxxx"
# sendgrid_from = "noreply@example.com"
# sendgrid_to = "admin@example.com,support@example.com"

# Webhook 配置
[notification.webhook]
enabled = true
urls = [
    "https://hooks.slack.com/services/xxx",
    "https://qyapi.weixin.qq.com/xxx"
]

# 代理配置
[proxy]
rules = [
    {
        path = "/"
        target = "http://localhost:3000"
        methods = ["GET", "POST", "PUT", "DELETE"]
    }
]
