{
  "server": {
    "http_port": 80,
    "https_port": 443,
    "read_timeout_sec": 30,
    "write_timeout_sec": 30,
    "idle_timeout_sec": 120
  },
  "security": {
    "enable_waf": true,
    
    "// ========== IP 维度封禁配置 ==========": "",
    "// 当单个 IP 在指定时间窗口内触发 WAF 规则达到阈值时，自动封禁该 IP": "",
    "waf_rate_limit_enabled": true,
    "waf_rate_limit_window": 60,
    "waf_rate_limit_max_hits": 10,
    "waf_rate_limit_block_sec": 3600,
    
    "// ========== TLS 指纹维度封禁配置 ==========": "",
    "// 当相同 TLS 指纹在指定时间窗口内触发 WAF 规则达到阈值时，封禁该指纹": "",
    "// 有效对抗使用相同工具/脚本的分布式攻击": "",
    "waf_tls_block_enabled": true,
    "waf_tls_block_window": 60,
    "waf_tls_block_max_hits": 10,
    "waf_tls_block_duration_sec": 3600,
    
    "// ========== IP 段维度封禁配置 ==========": "",
    "// 当同一网段内被封禁的 IP 数量达到阈值时，自动封禁整个网段": "",
    "// 有效对抗来自同一网段的大规模扫描": "",
    "waf_subnet_block_enabled": true,
    "waf_subnet_mask": 24,
    "waf_subnet_threshold": 3,
    "waf_subnet_block_duration_sec": 7200,
    
    "// ========== 配置说明 ==========": "",
    "// IP 维度配置：": "",
    "//   - waf_rate_limit_enabled: 是否启用 IP 封禁": "",
    "//   - waf_rate_limit_window: 时间窗口（秒），默认 60": "",
    "//   - waf_rate_limit_max_hits: 时间窗口内最大触发次数，默认 10": "",
    "//   - waf_rate_limit_block_sec: 封禁时长（秒），默认 3600（1小时）": "",
    "//": "",
    "// TLS 指纹维度配置：": "",
    "//   - waf_tls_block_enabled: 是否启用 TLS 指纹封禁": "",
    "//   - waf_tls_block_window: 时间窗口（秒），默认 60": "",
    "//   - waf_tls_block_max_hits: 时间窗口内最大触发次数，默认 10": "",
    "//   - waf_tls_block_duration_sec: 封禁时长（秒），默认 3600（1小时）": "",
    "//": "",
    "// IP 段维度配置：": "",
    "//   - waf_subnet_block_enabled: 是否启用 IP 段封禁": "",
    "//   - waf_subnet_mask: 网段掩码，默认 24（/24 = 256个IP）": "",
    "//   - waf_subnet_threshold: 同段被封IP数量阈值，默认 3": "",
    "//   - waf_subnet_block_duration_sec: 封禁时长（秒），默认 7200（2小时）": "",
    "//": "",
    "// ========== 推荐配置场景 ==========": "",
    "//": "",
    "// 1. 生产环境（标准）：": "",
    "//    IP: window=60, hits=10, block=3600": "",
    "//    TLS: window=60, hits=10, block=3600": "",
    "//    Subnet: mask=24, threshold=3, block=7200": "",
    "//": "",
    "// 2. 生产环境（严格）：": "",
    "//    IP: window=60, hits=5, block=7200": "",
    "//    TLS: window=60, hits=5, block=7200": "",
    "//    Subnet: mask=24, threshold=2, block=14400": "",
    "//": "",
    "// 3. 测试环境（宽松）：": "",
    "//    IP: window=120, hits=20, block=1800": "",
    "//    TLS: disabled": "",
    "//    Subnet: disabled": "",
    "//": "",
    "// 4. 遭受攻击时（超严格）：": "",
    "//    IP: window=30, hits=3, block=86400": "",
    "//    TLS: window=30, hits=3, block=86400": "",
    "//    Subnet: mask=16, threshold=2, block=86400": ""
  },
  "admin_prefix": "/sslcat-panel",
  "log_level": "info"
}

